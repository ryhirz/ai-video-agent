# ============================================================
# AI 视频剪辑智能体 —— 环境变量模板
# 用法：cp .env.example .env 后按需修改
# ⚠️ 生产环境必须改掉 MinIO 默认凭据并设置 API_KEY
# （.env 已被 .gitignore 与 .dockerignore 排除，不会进仓库/镜像）
# ============================================================

# ---------- 认证（高优先级） ----------
# 留空 = 认证关闭（历史行为）；设置后 /render* 四路由要求
# X-API-Key 头或 ?api_key= 查询参数（/health、/manifest、/app 保持公开）
API_KEY=

# ---------- 可观测性 ----------
# worker 侧 Prometheus 指标端口（worker 进程自带 /metrics 端点；
# 渲染终态计数/耗时/活跃数。app 进程的 :8000/metrics 只有路由指标
# + DB 队列深度快照——Prometheus 抓两个 target：8000 与 9101）
WORKER_METRICS_PORT=9101

# ---------- 结构化日志 ----------
# dev = 彩色文本（本地调试）；prod = 单行 JSON（日志采集）
LOG_ENV=dev
LOG_LEVEL=INFO

# ---------- MinIO 对象存储（可选） ----------
# 留空 → LocalStorage（成片落 app_outputs 卷，MinIO 容器可不启）
# minio:9000 → 走 compose 内 MinIO；其他主机 → host:port
MINIO_ENDPOINT=

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=renders
# 1 = 走 TLS（对外部托管 MinIO/S3 时按需开启）
MINIO_SECURE=0
