{
  "schema_version": "1.0.0",
  "operations": [
    "add_bgm",
    "add_subtitle",
    "add_text",
    "cut",
    "delete_clip",
    "delete_range",
    "effect",
    "move_clip",
    "speed",
    "transition",
    "trim"
  ],
  "transition_types": [
    "fade",
    "cross",
    "wipe"
  ],
  "transition": {
    "fade": {
      "video": "xfade=transition=fade",
      "audio": "acrossfade=c1=tri:c2=tri",
      "supported": true
    },
    "cross": {
      "video": "xfade=transition=fade",
      "audio": "acrossfade=c1=tri:c2=tri",
      "supported": true
    },
    "wipe": {
      "video": "xfade=transition=wiperight",
      "audio": "acrossfade=c1=tri:c2=tri",
      "supported": true
    }
  },
  "transition_policy": {
    "invalid_reference": "reject_at_validate",
    "non_adjacent_clips": "reject_at_validate",
    "duration_too_long": "reject_at_validate",
    "audio_track_missing": "skip_audio_transition_with_warning"
  },
  "gap_policy": {
    "fill": "tpad_black",
    "scope": "between_groups_only",
    "audio_fill": "silence",
    "audio_fill_desc": "组间 gap 处音频侧插入等长静音，与视频 tpad 黑帧同步，保证音画时长一致"
  },
  "subtitle_style": {
    "keys": [
      "font",
      "size",
      "color",
      "bg",
      "position"
    ]
  },
  "speed": {
    "rate": {
      "default": 1.0,
      "min": 0.01,
      "max": 1000,
      "description": "变速倍率；1.0 = 原速",
      "supported": true
    },
    "audio_backend": {
      "default": "atempo",
      "choices": [
        "atempo"
      ],
      "description": "音频变速后端；rubberband 本机构建可用但未启用",
      "supported": true
    }
  },
  "add_text": {
    "position": {
      "choices": [
        "top-left",
        "top-center",
        "top-right",
        "center-left",
        "center",
        "center-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "default": "bottom-center",
      "description": "九宫格锚点；x/y 非空时被覆盖",
      "supported": true
    },
    "margin": {
      "default": 20,
      "min": 0,
      "type": "number",
      "description": "边距像素",
      "supported": true
    },
    "x": {
      "default": null,
      "type": "number",
      "description": "像素坐标；非空时覆盖 position+margin",
      "supported": true
    },
    "y": {
      "default": null,
      "type": "number",
      "description": "像素坐标；非空时覆盖 position+margin",
      "supported": true
    },
    "font": {
      "default": "",
      "type": "string",
      "description": "字体名或字体文件路径；解析不到时降级 + unsupported",
      "supported": true
    },
    "size": {
      "default": 24,
      "min": 8,
      "max": 512,
      "type": "number",
      "supported": true
    },
    "color": {
      "default": "#FFFFFF",
      "type": "string",
      "supported": true
    },
    "bg": {
      "default": "",
      "type": "string",
      "description": "#RRGGBB / #RRGGBBAA；非空时启用背景框",
      "supported": true
    }
  },
  "transform": {
    "x": {
      "default": 0,
      "min": 0,
      "description": "水平偏移像素（等尺寸画布内偏移，超出裁边；不可为负）",
      "type": "number",
      "supported": true
    },
    "y": {
      "default": 0,
      "min": 0,
      "description": "垂直偏移像素（等尺寸画布内偏移，超出裁边；不可为负）",
      "type": "number",
      "supported": true
    },
    "rotation": {
      "default": 0,
      "description": "旋转弧度（rad）；可传数值，或含 t 的表达式",
      "type": "number",
      "supported": true
    },
    "opacity": {
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "description": "画面透明度",
      "type": "number",
      "supported": true
    },
    "scale": {
      "default": 1.0,
      "description": "缩放倍数（planned：当前由输出归一化接管，尚未编译落地）",
      "type": "number",
      "supported": false
    }
  },
  "effects": {
    "video": {
      "grayscale": {
        "kind": "simple",
        "aliases": [
          "灰度",
          "黑白"
        ],
        "filter": "hue=s=0"
      },
      "sepia": {
        "kind": "simple",
        "aliases": [
          "复古"
        ],
        "filter": "colorchannelmixer=.393:.769:.189:0:.349:.686:.168:0:.272:.534:.131"
      },
      "invert": {
        "kind": "simple",
        "aliases": [
          "反色"
        ],
        "filter": "negate"
      },
      "mirror": {
        "kind": "simple",
        "aliases": [
          "hflip",
          "水平翻转"
        ],
        "filter": "hflip"
      },
      "vflip": {
        "kind": "simple",
        "aliases": [
          "垂直翻转"
        ],
        "filter": "vflip"
      },
      "blur": {
        "kind": "param",
        "aliases": [
          "模糊"
        ],
        "filter_template": "{v}",
        "params": {
          "radius": {
            "default": 5,
            "min": 0,
            "max": 50,
            "type": "number",
            "supported": true
          }
        }
      },
      "brightness": {
        "kind": "param",
        "aliases": [
          "亮度"
        ],
        "filter_template": "brightness={v}",
        "params": {
          "value": {
            "default": 0.1,
            "min": -1,
            "max": 1,
            "type": "number",
            "supported": true
          }
        }
      },
      "contrast": {
        "kind": "param",
        "aliases": [
          "对比度"
        ],
        "filter_template": "contrast={v}",
        "params": {
          "value": {
            "default": 1.5,
            "min": 0,
            "max": 2,
            "type": "number",
            "supported": true
          }
        }
      },
      "saturation": {
        "kind": "param",
        "aliases": [
          "饱和度"
        ],
        "filter_template": "saturation={v}",
        "params": {
          "value": {
            "default": 1.5,
            "min": 0,
            "max": 2,
            "type": "number",
            "supported": true
          }
        }
      },
      "fade_in": {
        "kind": "fade",
        "aliases": [
          "淡入"
        ],
        "params": {
          "duration": {
            "min": 0,
            "max": 60,
            "type": "number",
            "supported": true
          }
        }
      },
      "fade_out": {
        "kind": "fade",
        "aliases": [
          "淡出"
        ],
        "params": {
          "duration": {
            "min": 0,
            "max": 60,
            "type": "number",
            "supported": true
          }
        }
      }
    },
    "audio": {
      "volume": {
        "kind": "param",
        "aliases": [
          "音量"
        ],
        "filter_template": "volume={v}",
        "params": {
          "value": {
            "default": 1.0,
            "min": 0,
            "max": 2,
            "type": "number",
            "supported": true
          }
        }
      },
      "fade_in": {
        "kind": "fade",
        "aliases": [
          "淡入"
        ],
        "params": {
          "duration": {
            "min": 0,
            "max": 60,
            "type": "number",
            "supported": true
          }
        }
      },
      "fade_out": {
        "kind": "fade",
        "aliases": [
          "淡出"
        ],
        "params": {
          "duration": {
            "min": 0,
            "max": 60,
            "type": "number",
            "supported": true
          }
        }
      }
    }
  },
  "internal_markers": [
    "bgm_mix",
    "speed"
  ]
}
