# ============================================================
# AI 视频剪辑智能体 —— 基础依赖（必装）
# ------------------------------------------------------------
# 覆盖：Gradio 界面 + 规则规划/语义删除/163 测试中除 YOLO 真实检测外的全部用例
#       + 真实出片（ffmpeg 已随本仓库打包在 tools/ffmpeg/bin，无需 pip 安装）
# 适用：想快速验证项目、跑界面、跑绝大多数测试的同学/老师。
# 注意：本文件不含 AI 模型依赖（torch/ultralytics/funasr），
#       M2「视觉理解(YOLO) / 语音转写(ASR)」按钮会显示「依赖未安装」提示，属正常降级。
# 若要启用完整 AI 能力 + 跑满 163 测试，请改用 requirements-full.txt。
# ============================================================

# ============================================================
# 版本策略（重要）：下界保证功能，上界锁住「大版本」
# ------------------------------------------------------------
# 为什么必须写上界：只写 `>=` 等于把「未来某个依赖发布不兼容大版本」这件事
# 交给运气。同一台机器上的 rz-home 项目就踩过：requirements 里写了
# passlib[bcrypt]==1.7.4 却没约束 bcrypt，CI 全新安装时装到 bcrypt 5.0.0，
# 结果密码哈希全线失败——bcrypt 5.0.0 起，hashpw 对超过 72 字节的密码
# 由「静默截断」改为「抛 ValueError」，passlib 的后端自检探测（255 字节探针）
# 因此在初始化时就崩，与用户输入无关。本地因 venv 恰好是旧版本而毫无征兆。
#
# 上界取值说明：以下上界均高于当前实测可用版本
#   （gradio 6.27.0 / numpy 2.5.3 / opencv-python 5.0.0.93）
# 因此不会改变今天实际装到的版本，只拦住下一个大版本。
# ============================================================

gradio>=4.0,<7          # 环境实测 6.27.0
numpy>=1.24,<3          # 环境实测 2.5.3
opencv-python>=4.7,<6   # 环境实测 5.0.0.93

# ---------- 全栈层（server/，第二步显式化） ----------
# ⚠️ fastapi/uvicorn 此前靠 gradio 传递依赖（搭便车）：server/ 直接 import
#    却未声明，gradio 换 Web 框架时 CI 全新安装会静默崩 —— 必须显式声明。
celery[redis]>=5.3,<7   # 异步任务队列 + Redis broker；环境实测 5.6.3
fastapi>=0.100,<1       # API 层；环境实测 0.141.1（原为 gradio 传递依赖）
uvicorn>=0.23,<1        # ASGI 服务器；环境实测 0.53.0（原为 gradio 传递依赖）
sqlalchemy>=2.0,<3      # render_tasks DAL；环境实测 2.1.6
minio>=7.0,<8           # 对象存储 SDK（第四步 MinIOStorage）；环境实测 7.2.20
structlog>=24.1,<27     # 结构化日志（dev 彩色 / prod JSON 双模）；环境实测 26.1.0，零运行时依赖
prometheus-client>=0.20,<1  # Prometheus 指标暴露（/metrics：请求计数/耗时/并发）；环境实测 0.26.0


# ---------- 测试工具 ----------
# 并入锁文件的原因：CI 用 `pip install --require-hashes -r <lock>` 安装，
# 该模式要求"每一个被安装的包都出现在锁文件里且带哈希"。
# 若 pytest 不进锁文件，就只能另起一条无哈希的安装命令，既失去可复现性，
# 又多出两处需要同步维护的清单。
pytest
